# Copy to .env and fill in; .env is gitignored. Atlas does not read this file
# by itself: ./migrate.sh (or ./migrate.ps1) loads it and runs atlas, and
# scripts/dev.sh loads it to run the API.
#
#   ./migrate.sh migrate status
#   ./migrate.sh migrate apply
#   ./migrate.sh migrate diff <name>

# Supabase, Connect -> Direct -> SESSION pooler (port 5432), with the password
# filled in and ?search_path=public&sslmode=require on the end. Not the direct
# connection (IPv6-only on the free plan) and not the transaction pooler
# (6543), which breaks pgx's prepared statements and Atlas's session state.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?search_path=public&sslmode=require

# Optional, for running the API locally (scripts/dev.sh reads this file):
# names and avatars at sign-in. steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# The R2 bucket, for publishing from Go (demo-export -upload, demo-catalog).
# Cloudflare -> R2 -> Manage API tokens -> an ACCOUNT token, Object Read &
# Write, on cs2-demo-payloads only. The secret is shown once.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=cs2-demo-payloads

# Uploads through the site need the R2 keys above; without them they are off.
# Who may upload is the uploaders table, not a setting here:
#   go run ./demo-catalog uploaders add <steamid> -note "who"

# Scratch database for `migrate diff`: Atlas starts a throwaway Postgres 17
# container, so Docker Desktop has to be running for a diff (not for apply or
# status). Never point this at the real database - Atlas drops objects in it.
# Without Docker, any empty throwaway database works, e.g. a local one:
# postgres://postgres@localhost:5432/atlas_dev?sslmode=disable&search_path=public
DATABASE_DEV_URL=docker://postgres/17/dev?search_path=public
