# Atlas does not read this file by itself. Use ./migrate.sh, which sources
# it and then runs atlas:  ./migrate.sh migrate diff initial

# Neon connection strings. Copy to .env and fill in; .env is gitignored.
# Neon gives you a pooled and a direct URL - use the DIRECT one for Atlas,
# because migrations need a real session, not a pooled connection.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/main?sslmode=require

# A throwaway database on the same Neon project. Atlas drops and recreates
# objects here to compute diffs, so it must not be your real one.
DATABASE_DEV_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/atlas_dev?sslmode=require
